# Base URL of the real FastAPI backend (see backend/app/main.py)
VITE_API_BASE_URL=http://localhost:8000

# When true, the hidden /dev menu's "Load known incident" fallback can be
# used if the backend cannot be reached. This never replaces the primary
# real-backend flow; it is a read-only fallback for demo reliability.
VITE_DEMO_MODE=false
